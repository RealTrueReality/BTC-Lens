@implements IAsyncDisposable
@inject IJSRuntime JS
<div class="chart-host" tabindex="0" aria-label="可绘图行情图表" @ref="host"><div class="chart-loading">正在绘制行情…</div></div>
@code {
    [Parameter] public Candle[] Candles { get; set; } = [];
    [Parameter] public DetectedZone[] Zones { get; set; } = [];
    [Parameter] public WatchZone[] Watches { get; set; } = [];
    [Parameter] public KeyLevel[] Levels { get; set; } = [];
    [Parameter] public bool ShowLevels { get; set; } = true;
    [Parameter] public string Tool { get; set; } = "select";
    [Parameter] public ChartDrawing[] Drawings { get; set; } = [];
    [Parameter] public SavedProfile[] Profiles { get; set; } = [];
    [Parameter] public ChartObjectSelection? Selection { get; set; }
    [Parameter] public VwapResult[] Vwaps { get; set; } = [];
    [Parameter] public string Scope { get; set; } = "";
    [Parameter] public EventCallback<(long Start, long End)> TimeRangeSelected { get; set; }
    [Parameter] public EventCallback<ChartObjectSelection> ObjectSelected { get; set; }
    [Parameter] public EventCallback<ChartObjectSelection> ObjectDeleted { get; set; }
    [Parameter] public EventCallback<DrawingChange> ObjectChanged { get; set; }
    [Parameter] public EventCallback ToolCancelled { get; set; }
    private ElementReference host;
    private IJSObjectReference? module;
    private IJSObjectReference? chart;
    private DotNetObjectReference<CandleChart>? reference;
    private string identity = "";
    private ChartObjectSelection? pendingFocus;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/chart.js");
                reference = DotNetObjectReference.Create(this);
                chart = await module.InvokeAsync<IJSObjectReference>("create", host, reference);
            }
            if (chart is null) return;
            var nextIdentity = Scope + ":" + Candles.FirstOrDefault()?.Timeframe;
            var reset = identity != nextIdentity; identity = nextIdentity;
            await chart.InvokeVoidAsync("update", Candles.Select(c => new { time = c.OpenTime / 1000, closeTime = c.CloseTime / 1000, open = c.Open, high = c.High, low = c.Low, close = c.Close, volume = c.Volume, confirmed = c.Confirmed }),
                Zones.Select(z => new { id = z.Id, lower = z.Lower, upper = z.Upper, start = z.SourceTime / 1000, end = z.KnownAt / 1000, bias = z.Bias.ToString(), label = z.Timeframe + " " + LensFormat.Kind(z.Kind) }),
                Watches.Where(w => w.Enabled).Select(w => new { id = w.Id, revision = w.Current.Revision, lower = w.Current.Lower, upper = w.Current.Upper,
                    start = (w.Current.Trend?.Start ?? w.Current.ChartAnchor?.Start ?? w.Current.CreatedAt.ToUnixTimeMilliseconds()) / 1000,
                    end = (w.Current.Trend?.End ?? w.Current.ChartAnchor?.End ?? Candles.LastOrDefault()?.CloseTime ?? w.Current.CreatedAt.ToUnixTimeMilliseconds()) / 1000,
                    price1 = w.Current.Trend?.Price1, price2 = w.Current.Trend?.Price2, tolerance = w.Current.Trend?.Tolerance,
                    drawingKind = w.Current.Trend is null ? null : "TrendLine", label = w.Current.Name }),
                ShowLevels ? Levels.Select(l => new { name = l.Name, price = l.Price }).ToArray() : [], Tool, reset,
                Profiles.Select(p => new { id = p.Id, label = p.Name, start = p.Result.Start / 1000, end = p.Result.End / 1000,
                    p.Result.Rows, p.Result.Poc, p.Result.Vah, p.Result.Val, p.Result.PocRow, p.Result.VaLowRow, p.Result.VaHighRow }), ChartVwapData(),
                Drawings.Select(d => new { id = d.Id, revision = d.Revision, drawingKind = d.Kind.ToString(), label = d.Name,
                    start = d.Start / 1000, end = d.End / 1000, price1 = d.Price1, price2 = d.Price2 }), Selection, Scope);
            if (pendingFocus is { } focus && await chart.InvokeAsync<bool>("focus", focus.Kind, focus.Id)) pendingFocus = null;
        }
        catch (JSDisconnectedException) { }
    }
    [JSInvokable] public Task PickedRange(long start, long end) => TimeRangeSelected.InvokeAsync((start * 1000, end * 1000));
    [JSInvokable] public Task Selected(string kind, string id) => ObjectSelected.InvokeAsync(new(kind, id));
    [JSInvokable] public Task DeleteObject(string kind, string id) => ObjectDeleted.InvokeAsync(new(kind, id));
    [JSInvokable] public Task SaveObject(DrawingChange change) => ObjectChanged.InvokeAsync(change);
    [JSInvokable] public Task CancelTool() => ToolCancelled.InvokeAsync();
    public Task FocusAsync(string kind, string id) { pendingFocus = new(kind, id); return InvokeAsync(StateHasChanged); }
    private object[] ChartVwapData()
    {
        return Vwaps.Select(v =>
        {
            var points = new List<object>(); var index = 0; VwapPoint? latest = null;
            foreach (var c in Candles)
            {
                while (index < v.Points.Length && v.Points[index].KnownAt <= c.OpenTime) latest = v.Points[index++];
                if (latest is not null) points.Add(new { time = c.OpenTime / 1000, value = latest.Value, segment = latest.Segment });
            }
            if (Candles.Length > 0 && v.Points.LastOrDefault() is { } last && last.KnownAt > Candles[^1].OpenTime)
                points.Add(new { time = last.KnownAt / 1000, value = last.Value, segment = last.Segment });
            return (object)new { v.Period, complete = v.Coverage.Complete, points };
        }).ToArray();
    }
    public async ValueTask DisposeAsync()
    {
        try { if (chart is not null) { await chart.InvokeVoidAsync("dispose"); await chart.DisposeAsync(); } if (module is not null) await module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
        reference?.Dispose();
    }
}
