@inject MarketEngine Market
@inject IJSRuntime JS
@inject ISnackbar Snack
@implements IDisposable
<section class="panel price-context-panel" data-testid="price-context">
    <div class="panel-heading"><div><span class="eyebrow">PRICE &amp; VOLUME CONTEXT</span><h2>成交量分布与 VWAP</h2></div><label class="context-timezone">VWAP 重置时区<select aria-label="VWAP 重置时区" value="@View.PriceContext.OffsetHours" @onchange="ChangeOffset"><option value="8">北京时间 UTC+8</option><option value="0">UTC</option></select></label></div>
    <div class="vwap-grid">
        @foreach (var v in View.PriceContext.Vwaps)
        {
            <div class="vwap-card" data-period="@v.Period" data-complete="@v.Coverage.Complete.ToString().ToLowerInvariant()"><div class="vwap-heading"><span>@(PriceContextRules.PeriodName(v.Period)) VWAP</span><span class="pill @(Usable(v) ? "green" : "amber")">@(Usable(v) ? "锚点覆盖完整" : "覆盖不完整 / 等待更新")</span></div><b class="mono">@LensFormat.Price(v.Value)</b><small>从 @LensFormat.Time(v.Anchor) · 截至 @LensFormat.Time(v.KnownAt)</small><div class="vwap-foot"><span>@v.Coverage.Observed / @v.Coverage.Expected 根 5m · @(Usable(v) ? "收盘近似" : "部分数据近似")</span><button class="text-button accent" disabled="@(!Usable(v))" @onclick="() => FromVwap(v)">＋ 关注</button></div></div>
        }
    </div>
    <div class="context-status"><span>@View.PriceContext.Status · @View.ContextCandles.Length 根 5m</span><span>永续成交量：张数 × BTC 合约面值 · 已收盘 HLC3 近似</span></div>
    @if (View.PriceContext.Error is not null) { <p class="inline-error">@View.PriceContext.Error</p> }
    <div class="profile-heading"><div><h3>固定范围成交量分布</h3><p>圈选盘整区间，保存 VAH / POC / VAL。使用 5m K 线高低区间均匀分配近似。</p></div><div class="button-group"><button class="button small" @onclick="() => DrawRange.InvokeAsync()">图上选择时间范围</button><button class="button small primary" @onclick="NewRange">填写时间范围</button></div></div>
    @if (View.PriceContext.Profiles.Length > 0)
    {
        <div class="profile-list" aria-label="已保存成交量选区">
            @foreach (var p in View.PriceContext.Profiles)
            {
                <div class="profile-item @(SelectedId == p.Id ? "selected" : "")" data-profile-id="@p.Id" @key="p.Id"><div><button class="text-button" @onclick="() => SelectedChanged.InvokeAsync(p.Id)">@p.Name</button><small>@LensFormat.Time(p.Result.Start) — @LensFormat.Time(p.Result.End)</small></div><div class="button-group"><label><input type="checkbox" checked="@p.Visible" aria-label="@("显示选区 " + p.Name)" @onchange="e => ToggleVisible(p, e)" />显示</label><button class="text-button" @onclick="() => LocateRequested.InvokeAsync(p.Id)">定位</button><button class="text-button danger" @onclick="() => Delete(p)">删除</button></div></div>
            }
        </div>
    }
    @if (Selected is { } selected)
    {
        var r = selected.Result;
        <div class="profile-detail" data-testid="profile-detail" data-profile-id="@selected.Id">
            <div class="profile-levels">@foreach (var level in new[] { ("VAH", r.Vah), ("POC", r.Poc), ("VAL", r.Val) }) { <div><span>@level.Item1</span><b class="mono">@LensFormat.Price(level.Item2)</b><button class="text-button accent" @onclick="() => FromProfile(selected, level.Item1, level.Item2!.Value)">＋ 关注</button></div> }</div>
            <div class="profile-coverage"><span class="pill @(r.Coverage.Complete ? "green" : "amber")">@(r.Coverage.Complete ? "选区覆盖完整" : "选区数据不完整")</span><span>@r.Coverage.Observed / @r.Coverage.Expected 根 · 缺失 @r.Coverage.Missing 根 · 冲突 @r.Coverage.Conflicts 组</span><span>@r.TotalBtc.ToString("0.########") BTC · @r.Rows.Length 行 · 价值区目标 @r.ValueAreaPercent%</span><button class="text-button push-right" @onclick="() => Export(selected)">导出选区证据 ↗</button></div>
            <details><summary>选区来源与计算规则</summary><p class="muted">@LensFormat.Time(r.Start) 至 @LensFormat.Time(r.End)，右端不含；创建时点 @LensFormat.Time(selected.CreatedAt)。POC 使用最大成交量行的中点，并列取低价行；价值区从 POC 向较大相邻行扩展，直至达到或超过目标比例。</p><p class="muted">@r.Algorithm · 来源 SHA-256：<span class="source-hash">@r.SourceHash</span></p></details>
        </div>
    }
    else { <div class="profile-empty">先选择一段时间，图上将显示成交量横条和 VAH / POC / VAL。</div> }
</section>
@if (form is not null)
{
    <div class="modal-backdrop"><section class="modal wide" role="dialog" aria-modal="true" aria-label="成交量选区编辑"><div class="modal-heading"><div><span class="eyebrow">FIXED RANGE · 5M APPROXIMATION</span><h2>保存成交量选区</h2></div><button class="icon-button" aria-label="关闭成交量选区" @onclick="Close">×</button></div>
        <form @onsubmit="Save" @onsubmit:preventDefault><label>选区名称<input required maxlength="100" disabled="@busy" @bind="form.Name" /></label><div class="form-grid"><label>开始时间（北京时间，包含）<input type="datetime-local" required step="300" disabled="@busy" @bind="form.Start" @bind:after="ResetPreview" /></label><label>结束时间（北京时间，不含）<input type="datetime-local" required step="300" disabled="@busy" @bind="form.End" @bind:after="ResetPreview" /></label><label>成交量分布行数<input type="number" min="8" max="120" required disabled="@busy" @bind="form.Rows" @bind:after="ResetPreview" /></label><label>价值区比例（%）<input type="number" min="1" max="100" required disabled="@busy" @bind="form.Area" @bind:after="ResetPreview" /></label></div><p class="form-note">预览或保存时，自动从 OKX 补取所选区间缺失的 5m 历史，已下载数据会保留供下次复用。支持超过 40 天的选区；开始和结束时间需对齐 5 分钟，且不能晚于当前已收盘时间。</p>
        @if (busy && loadProgress is { } loading) { <div class="profile-preview" data-testid="profile-load" role="status" aria-live="polite">@loading.Status<p>已加载 @loading.Loaded / @loading.Expected 根 · 已请求 @loading.Pages 页</p><progress value="@loading.Loaded" max="@Math.Max(1, loading.Expected)" aria-label="历史加载进度" style="width:100%"></progress></div> }
        @if (preview is not null) { <div class="profile-preview" data-testid="profile-preview">POC <b>@LensFormat.Price(preview.Poc)</b> · VAH <b>@LensFormat.Price(preview.Vah)</b> · VAL <b>@LensFormat.Price(preview.Val)</b><p>覆盖 @preview.Coverage.Observed / @preview.Coverage.Expected 根，缺失 @preview.Coverage.Missing 根；@preview.TotalBtc.ToString("0.########") BTC。@(preview.Coverage.Complete ? "选区覆盖完整。" : "数据不完整，保存结果仅代表已覆盖部分。")</p></div> }
        @if (error is not null) { <p class="inline-error">@error</p> }
        <div class="modal-actions">@if (busy) { <button type="button" class="button" @onclick="CancelLoad">取消加载</button> }<button type="button" class="button" disabled="@busy" @onclick="Preview">@(busy ? "正在加载…" : "预览计算")</button><button type="submit" class="button primary" disabled="@(busy || preview is { Poc: null })">@(preview is { Coverage.Complete: false } ? "保存已覆盖部分" : "保存选区")</button></div></form></section></div>
}
@code {
    [Parameter] public MarketView View { get; set; } = MarketView.Empty;
    [Parameter] public string? SelectedId { get; set; }
    [Parameter] public EventCallback<string> SelectedChanged { get; set; }
    [Parameter] public EventCallback<string> LocateRequested { get; set; }
    [Parameter] public EventCallback DrawRange { get; set; }
    [Parameter] public EventCallback<(PriceReference Reference, string Timeframe)> LevelPicked { get; set; }
    [Parameter] public string Timeframe { get; set; } = "5m";
    private SavedProfile? Selected => View.PriceContext.Profiles.FirstOrDefault(p => p.Id == SelectedId);
    private RangeForm? form;
    private ProfileResult? preview;
    private string? error, formScope;
    private bool busy;
    private ProfileLoadProgress? loadProgress;
    private CancellationTokenSource? activeLoad;
    private string previousScope = "";
    protected override void OnParametersSet() { if (previousScope != View.Scope) { previousScope = View.Scope; Close(); } }
    private bool Usable(VwapResult v) => v.Value is not null && v.Coverage.Complete && v.KnownAt <= View.Cutoff && View.Cutoff - v.KnownAt < 600_000 && v.Anchor == PriceContextRules.Anchor(View.Cutoff, v.Period, v.OffsetHours);
    private async Task ChangeOffset(ChangeEventArgs e) => await Market.SetVwapOffsetAsync(int.Parse(e.Value!.ToString()!));
    private async Task ToggleVisible(SavedProfile profile, ChangeEventArgs e)
    {
        try { await Market.SetProfileVisibilityAsync(profile.Id, e.Value is true, View.Scope); }
        catch (ArgumentException ex) { Snack.Add(ex.Message, Severity.Warning); }
    }
    private async Task Delete(SavedProfile profile)
    {
        try { await Market.DeleteProfileAsync(profile.Id, View.Scope); Snack.Add("成交量选区已删除。", Severity.Success); }
        catch (ArgumentException ex) { Snack.Add(ex.Message, Severity.Warning); }
    }
    private void NewRange()
    {
        var end = Math.Min(View.ContextCandles.LastOrDefault()?.CloseTime ?? View.Cutoff, View.Cutoff / PriceContextRules.Step * PriceContextRules.Step);
        OpenRange(Math.Max(View.ContextCandles.FirstOrDefault()?.OpenTime ?? end - 3_600_000, end - 6 * 3_600_000), end);
    }
    public void OpenRange(long start, long end)
    {
        Close();
        formScope = View.Scope; preview = null; error = null;
        form = new() { Start = Local(start), End = Local(Math.Min(end, View.Cutoff / PriceContextRules.Step * PriceContextRules.Step)) };
        StateHasChanged();
    }
    private void Close() { activeLoad?.Cancel(); activeLoad = null; busy = false; loadProgress = null; form = null; ResetPreview(); }
    private void ResetPreview() { preview = null; error = null; }
    private void CancelLoad() => activeLoad?.Cancel();
    public void Dispose() => Close();
    private static DateTime Local(long time) => DateTimeOffset.FromUnixTimeMilliseconds(time).ToOffset(TimeSpan.FromHours(8)).DateTime;
    private static long Timestamp(DateTime time) => new DateTimeOffset(DateTime.SpecifyKind(time, DateTimeKind.Unspecified), TimeSpan.FromHours(8)).ToUnixTimeMilliseconds();
    private Task Preview() => Compute(false);
    private Task Save() => Compute(true);
    private async Task Compute(bool save)
    {
        if (busy || form is null) return;
        var f = form; var start = Timestamp(f.Start); var end = Timestamp(f.End); var rows = f.Rows; var area = f.Area;
        var scope = formScope!; var timeframe = Timeframe; var allowPartial = preview is { Coverage.Complete: false };
        using var request = new CancellationTokenSource(); activeLoad = request; busy = true; error = null; preview = null;
        loadProgress = new(0, 0, 0, "正在检查选区与本地缓存");
        var progress = new Progress<ProfileLoadProgress>(p => { _ = InvokeAsync(() => {
            if (activeLoad == request && !request.IsCancellationRequested) { loadProgress = p; StateHasChanged(); }
        }); });
        try
        {
            var result = await Market.PreviewProfileAsync(start, end, rows, area, scope, progress, request.Token);
            request.Token.ThrowIfCancellationRequested();
            if (activeLoad != request || form != f) return;
            preview = result;
            if (!save) return;
            if (!result.Coverage.Complete && !allowPartial) { error = "所选区间仍有缺失数据，请检查预览；可以重试补取，或选择「保存已覆盖部分」。"; return; }
            var saved = await Market.SaveProfileAsync(f.Name, timeframe, start, end, rows, area, scope, progress, request.Token, allowIncomplete: allowPartial);
            await SelectedChanged.InvokeAsync(saved.Id); Close(); Snack.Add("已保存选区与原始 5m 证据。", Severity.Success);
        }
        catch (OperationCanceledException) when (request.IsCancellationRequested)
        { if (activeLoad == request) error = "已取消加载，已下载数据仍在本地；再次预览会继续补取。"; }
        catch (ArgumentException ex) { if (activeLoad == request) error = ex.Message; }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException or InvalidDataException)
        { if (activeLoad == request) error = "历史数据补取失败，已下载部分仍保留；请重试。" + (ex is InvalidDataException ? ex.Message : ""); }
        finally { if (activeLoad == request) { activeLoad = null; busy = false; } }
    }
    private Task FromProfile(SavedProfile p, string role, decimal price) => LevelPicked.InvokeAsync((new("profile", p.Id, p.Name + " · " + role, price, p.CreatedAt, p.Result.Algorithm, p.Result.SourceHash), p.DisplayTimeframe));
    private Task FromVwap(VwapResult v) => LevelPicked.InvokeAsync((new("vwap", $"vwap:{View.Scope}:{v.Period}:{v.OffsetHours}:{v.KnownAt}", PriceContextRules.PeriodName(v.Period) + " VWAP", v.Value!.Value, v.KnownAt, PriceContextRules.VwapVersion, v.SourceHash), Timeframe));
    private async Task Export(SavedProfile p) { await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/files.js"); await module.InvokeVoidAsync("download", "btclens-volume-profile.json", JsonCodec.Write(p)); }
    private sealed class RangeForm { public string Name { get; set; } = "盘整区间"; public DateTime Start { get; set; } public DateTime End { get; set; } public int Rows { get; set; } = 40; public decimal Area { get; set; } = 70; }
}
