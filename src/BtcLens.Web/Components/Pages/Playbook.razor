@page "/playbook"
@inject StudyStore Studies
@inject MarketEngine Market
<PageTitle>我的看盘规则 · BTC Lens</PageTitle>
<div class="page-heading"><div><div class="eyebrow">PERSONAL PLAYBOOK</div><h1>我的看盘规则<span class="title-dot">.</span></h1><p>记录个人确认条件，保留来源与每次修改版本。</p></div><span class="pill">规则 v@(profile.Revision)</span></div>
<section class="panel connection-panel" data-testid="playbook" data-ready="@ready.ToString().ToLowerInvariant()">
    <div class="panel-heading"><h2>Lecture 34 · 证据角色与冲突</h2></div>
    <p>来自你上传的课程笔记及 Lecture 1、10 的补充。原视频、图表与逐句时间戳未重新核验；这些条目目前是参考草稿。勾选复核只记录你的选择。</p>
    <div class="rule-card-grid">@foreach(var item in reviews){<article class="rule-card"><div><b>@item.Card.Title</b><label><input type="checkbox" @bind="item.Reviewed" />我已复核此条</label></div><p>@item.Card.Summary</p><small>@item.Card.SourceFile · @string.Join(" / ",item.Card.Anchors)</small><small>@item.Card.SourceStatus</small><label>我的补充<textarea rows="2" maxlength="2000" @bind="item.Notes"></textarea></label><details><summary>笔记版本摘要</summary><code>@item.Card.SourceHash</code></details></article>}</div>
    <h3>参考检测参数</h3><p class="muted">改变参数会建立新版本；历史分析继续引用旧参数。固定摆动和实体阈值不能自动证明课程中的“重大结构”。</p>
    <div class="form-grid three"><label>局部周期<select @bind="lowerTf"><option>5m</option><option>15m</option></select></label><label>左右摆动根数<input type="number" min="1" max="10" @bind="pivot" /></label><label>区间回收回看根数<input type="number" min="10" max="100" @bind="lookback" /></label><label>位移实体 / 前 14 根 ATR<input type="number" step="0.1" min="0.5" max="5" @bind="atr" /></label><label>实体 / 整根高低区间<input type="number" step="0.05" min="0.3" max="0.95" @bind="fraction" /></label><label>区域接近距离（%）<input type="number" step="0.01" min="0.01" max="2" @bind="near" /></label><label>价格方向阈值（%）<input type="number" step="0.001" min="0.001" max="5" @bind="priceThreshold" /></label><label>主动量差额 / 总量（%）<input type="number" step="0.1" min="0.1" max="50" @bind="flowThreshold" /></label><label>OI 变化阈值（%）<input type="number" step="0.001" min="0.001" max="10" @bind="oiThreshold" /></label></div>
    <div class="modal-actions"><button class="button primary" @onclick="SaveRules">保存规则新版本</button></div>
    @if(message is not null){<div class="@(error?"inline-error":"form-note")" role="status">@message</div>}
</section>
<section class="panel connection-panel" style="margin-top:20px" data-testid="study-intent"><div class="panel-heading"><h2>当前人工观察路线</h2><span class="pill">v@(intent.Revision)</span></div><p>目标和反应区分开定义。选择时间会保存，不能事后补成旧候选的事前目标。此处记录观察路线，不建立交易委托。</p><div class="form-grid three"><label>观察方向<select aria-label="观察方向" @bind="bias"><option value="Neutral">待观察</option><option value="Bullish">看涨</option><option value="Bearish">看跌</option></select></label><label>观察目标（USDT）<input type="number" step="0.1" min="0.1" @bind="target" /></label><label>失效参考（USDT）<input type="number" step="0.1" min="0.1" @bind="invalidation" /></label></div><label>目标来源与理由<textarea rows="3" maxlength="2000" @bind="reason"></textarea></label><label class="check-label"><input type="checkbox" @bind="targetReviewed" />我已区分此目标与反应区、诱导位</label><div class="modal-actions"><button class="button primary" @onclick="SaveIntent">保存新的观察路线</button></div>@if(intentMessage is not null){<div class="@(intentError?"inline-error":"form-note")" role="status">@intentMessage</div>}</section>
@code {
    private RuleProfile profile=RuleProfile.Default;private StudyIntent intent=StudyIntent.Empty;
    private Editor[] reviews=[];private int pivot,lookback;private decimal atr,fraction,near,priceThreshold,flowThreshold,oiThreshold;private string lowerTf="5m";
    private string? message,intentMessage;private bool error,intentError,targetReviewed,ready;private Bias bias;private decimal? target,invalidation;private string reason="",scope="";
    protected override void OnAfterRender(bool firstRender){if(firstRender){ready=true;StateHasChanged();}}
    protected override void OnInitialized(){profile=Studies.Profile;var p=profile.Parameters;pivot=p.PivotSize;lookback=p.SweepLookback;atr=p.BodyAtr;fraction=p.BodyFraction;near=p.NearPercent;priceThreshold=p.PricePercent;flowThreshold=p.FlowPercent;oiThreshold=p.OiPercent;lowerTf=p.LowerTimeframe;reviews=StudyRules.Cards.Select(c=>new Editor{Card=c,Reviewed=profile.Reviews.First(r=>r.Id==c.Id).Reviewed,Notes=profile.Reviews.First(r=>r.Id==c.Id).Notes}).ToArray();scope=Market.View.Scope;intent=Studies.Intent(scope);bias=intent.Bias;target=intent.Target;invalidation=intent.Invalidation;reason=intent.TargetReason;targetReviewed=intent.TargetReviewed;}
    private void SaveRules(){try{profile=Studies.SaveProfile(new(0,0,new(pivot,lookback,atr,fraction,priceThreshold,flowThreshold,oiThreshold,near,lowerTf),reviews.Select(r=>new RuleReview(r.Card.Id,r.Reviewed,r.Notes)).ToArray()),profile.Revision,Market.View.Cutoff);message="已保存规则 v"+profile.Revision+"，下次分析使用新版本。";error=false;}catch(ArgumentException ex){message=ex.Message;error=true;}}
    private void SaveIntent(){try{intent=Studies.SaveIntent(scope,new(0,0,bias,target,invalidation,reason,targetReviewed),intent.Revision,Market.View);intentMessage="已保存观察路线 v"+intent.Revision+"，目标与选择时间已记录。";intentError=false;}catch(ArgumentException ex){intentMessage=ex.Message;intentError=true;}}
    private sealed class Editor{public required RuleCard Card {get;init;}public bool Reviewed{get;set;}public string Notes{get;set;}="";}
}
