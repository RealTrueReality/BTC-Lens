@page "/"
@implements IDisposable
@inject MarketEngine Market
@inject ILensStore Store
@inject ISnackbar Snack
@inject IJSRuntime JS
<PageTitle>行情雷达 · BTC Lens</PageTitle>
<div class="page-heading"><div><div class="eyebrow">OBSERVE WITH INTENTION</div><h1>行情雷达<span class="title-dot">.</span></h1><p>发现参考区域，保留自己的判断。</p></div><button class="button primary" @onclick="NewWatch"><span>＋</span> 添加关注区</button></div>
<div class="live-banner"><span class="status-dot"></span><span>@view.Status</span><span class="muted">公共行情 · 无需账户密钥 · @view.Transport</span><span class="push-right muted">@(view.Quote is null ? "等待价格" : "价格时间 " + LensFormat.Time(view.Quote.Timestamp))</span></div>
@if (view.Error is not null) { <div class="inline-error">@view.Error</div> }
<div class="metric-grid">
    <div class="metric"><span class="metric-label"><span class="btc-mini">₿</span> BTC / USDT <span class="metric-unit">永续</span></span><div class="metric-number mono">@LensFormat.Price(view.Quote?.Price)<small>USDT</small></div><span class="metric-foot">最新观测价 · @view.Transport</span></div>
    <div class="metric"><span class="metric-label">我的关注区</span><div class="metric-number mono">@watches.Count(w => w.Enabled)<small>监控中</small></div><span class="metric-foot"><span class="tiny-line amber-line"></span>@watches.Count(w => w.Triggered) 个已记录首次到区</span></div>
    <div class="metric"><span class="metric-label">自动参考区域</span><div class="metric-number mono">@view.Zones.Count(z => z.Life == ZoneLife.Active)<small>未回访</small></div><span class="metric-foot">FVG + Reference OB · 已确认数据</span></div>
    <div class="metric"><span class="metric-label">到区记录</span><div class="metric-number mono">@alerts.Length<small>本工作区</small></div><span class="metric-foot">触发价格与证据快照一起保留</span></div>
</div>
<div class="radar-grid">
    <section class="panel chart-panel">
        <div class="panel-heading"><div class="instrument-title"><span class="btc-icon">₿</span><div><b>Bitcoin <span class="muted">/ USDT</span></b><small>OKX · 永续合约 · @timeframe</small></div></div><div class="timeframes">@foreach (var tf in Timeframes.All) { <button class="@(timeframe == tf ? "active" : "")" @onclick="() => timeframe = tf">@tf</button> }</div></div>
        <div class="chart-toolbar"><div class="layer-options"><label><input type="checkbox" @bind="showFvg" /><span class="legend-dot green"></span>FVG</label><label><input type="checkbox" @bind="showOb" /><span class="legend-dot red"></span>OB</label><label><input type="checkbox" @bind="showLevels" />关键价格</label><label><input type="checkbox" @bind="showHtf" />1D / 4H 投影</label></div><button class="text-button" @onclick="() => objectsOpen = !objectsOpen">图上对象 (@(ChartZones.Length + drawings.Length + watches.Count(w => w.Enabled) + ChartProfiles.Length))</button></div>
        <div class="chart-toolbar context-layers"><div class="layer-options"><label><input type="checkbox" @bind="showDayVwap" /><span class="legend-dot green"></span>日 VWAP</label><label><input type="checkbox" @bind="showWeekVwap" /><span class="legend-dot amber"></span>周 VWAP</label><label><input type="checkbox" @bind="showMonthVwap" />月 VWAP</label><label><input type="checkbox" @bind="showProfile" />固定范围分布</label></div></div>
        <div class="drawing-tools" role="toolbar" aria-label="图表绘图工具">
            <button class="@(tool == "select" ? "active" : "")" @onclick='() => SetTool("select")'>↖ 选择</button>
            <button class="@(tool == "Rectangle" ? "active" : "")" @onclick='() => SetTool("Rectangle")'>▭ 矩形</button>
            <button class="@(tool == "HorizontalLine" ? "active" : "")" @onclick='() => SetTool("HorizontalLine")'>― 水平线</button>
            <button class="@(tool == "TrendLine" ? "active" : "")" @onclick='() => SetTool("TrendLine")'>╱ 趋势线</button>
            <button class="@(tool == "profile" ? "active" : "")" @onclick="ToggleRangeDrawing">▥ 成交量选区</button>
            @if (tool != "select") { <button @onclick='() => SetTool("select")'>取消 · Esc</button> }
        </div>
        @if (tool != "select") { <div class="drawing-hint">@(tool == "HorizontalLine" ? "点击一个价格位置绘制水平线。" : tool == "profile" ? "依次点击区间起点和终点，可重复建立多个成交量选区。" : "依次点击两个端点；画好后点击「加入关注」。趋势线可按斜率监控动态价格。")</div> }
        @if (selection is not null)
        {
            <div class="chart-selection" data-testid="chart-selection"><div><b>@SelectionName</b><small class="mono">@SelectionRange</small></div><div class="button-group">
                @if (SelectedZone is not null || SelectedDrawing is not null) { <button class="button small primary" @onclick="PromoteSelection">加入关注</button> }
                @if (SelectedWatch is { } chosenWatch) { <button class="button small" @onclick="() => EditWatch(chosenWatch)">编辑关注区</button> }
                @if (SelectedProfile is { } chosenProfile && selection.Kind == "profile") { <button class="button small primary" @onclick="() => ProfilePoc(chosenProfile)">关注 POC</button> }
                <button class="text-button" @onclick="FocusSelection">定位</button>
                @if (selection.Kind != "zone") { <button class="text-button danger" @onclick="() => DeleteObject(selection)">删除所选</button> }
                <button class="icon-button" aria-label="取消选择" @onclick="() => selection = null">×</button>
            </div></div>
        }
        @if (objectsOpen) { <div class="chart-object-manager" aria-label="图上对象列表">
            @foreach (var z in ChartZones) { <button @onclick='() => SelectAndFocus(new("zone", z.Id))'>@z.Timeframe @LensFormat.Kind(z.Kind)<small>@LensFormat.Price(z.Lower) — @LensFormat.Price(z.Upper)</small></button> }
            @foreach (var d in drawings) { <button @onclick='() => SelectAndFocus(new("drawing", d.Id))'>@d.Name<small>@LensFormat.Price(d.Lower) — @LensFormat.Price(d.Upper)</small></button> }
            @foreach (var p in ChartProfiles) { <button @onclick='() => SelectAndFocus(new("profile", p.Id))'>@p.Name<small>成交量分布 · @LensFormat.Time(p.Result.Start)</small></button> }
            @foreach (var w in watches.Where(w => w.Enabled)) { <button @onclick='() => SelectAndFocus(new("watch", w.Id))'>@w.Current.Name<small>关注 · @WatchRange(w.Current)</small></button> }
        </div> }
        <CandleChart @ref="candleChart" Candles="CurrentCandles" Zones="ChartZones" Watches="watches" Levels="view.Levels" ShowLevels="showLevels" Tool="@tool" Scope="@view.Scope" TimeRangeSelected="RangePicked" Profiles="ChartProfiles" Drawings="drawings" Selection="selection" ObjectSelected="SelectObject" ObjectChanged="SaveChartObject" ObjectDeleted="DeleteObject" ToolCancelled='() => SetTool("select")' Vwaps="ChartVwaps" />
        <div class="chart-caption"><span>点击图上区域或标签选择 · 拖动所选绘图调整 · Delete 删除</span><span>UTC+8 · OB / FVG 仅显示未回访区域</span></div>
    </section>
    <section class="panel watch-panel"><div class="panel-heading"><h2>我的关注区 <span class="count-badge">@watches.Length</span></h2><button class="icon-button" aria-label="新增关注区" @onclick="NewWatch">＋</button></div>
        <div class="watch-list">
            @if (watches.Length == 0) { <div class="empty-state"><span>◇</span><b>选择你想等待的区域</b><p>点击图上的 OB / FVG，或画一个矩形，再加入关注。</p></div> }
            @foreach (var w in watches)
            {
                <div class="watch-card @(!w.Enabled ? "paused" : "")"><div class="watch-top"><span class="pill @(w.Current.Bias == Bias.Bullish ? "green" : w.Current.Bias == Bias.Bearish ? "red" : "")">@w.Current.Timeframe · @LensFormat.BiasName(w.Current.Bias)</span><span class="watch-status @(w.Triggered ? "accent" : "")">@(w.Triggered ? w.Current.Trend is null ? "已到区" : "已记录靠近／穿越" : !w.Enabled ? "已暂停" : view.Quote is not null && WatchRules.Inside(w.Current, view.Quote.Price, view.Quote.Timestamp) ? "当前在区内" : w.Current.Trend is null ? "等待到区" : "等待靠近／穿越")</span></div><h3>@w.Current.Name</h3><div class="watch-price mono">@WatchRange(w.Current)</div><p>@w.Current.Notes</p>
                    @if (w.Current.Trend is { } trend) { <small class="source-note">趋势线动态关注 · 上下各 @trend.Tolerance.ToString("0.0") USDT · 本版本首次靠近或穿越时记录</small> }
                    @if (w.Current.SourceZoneId is not null) { <small class="source-note">来源状态：@(view.Zones.FirstOrDefault(z => z.Id == w.Current.SourceZoneId) is { } origin ? LensFormat.Life(origin.Life) : "当前窗口未覆盖") · 手动边界保留</small> }
                    @if (w.Current.PriceReference is { } reference) { <small class="source-note">参考来源：@reference.Label · 保存时 @LensFormat.Price(reference.Price) · @LensFormat.Time(reference.KnownAt)</small> }
                    <div class="watch-actions"><small>v@(w.Current.Revision)</small><div><button class="text-button" @onclick='() => SelectAndFocus(new("watch", w.Id))'>定位</button><button class="text-button" @onclick="() => EditWatch(w)">编辑</button><button class="text-button" @onclick="() => Market.ToggleWatchAsync(w.Id)">@(w.Enabled ? "暂停" : "启用")</button><button class="text-button danger" title="删除关注区并停止监控" @onclick="() => DeleteWatch(w)">删除</button></div></div></div>
            }
        </div><div class="panel-tip">到区记录帮助你回看价格反应；确认条件与目标由你判断。</div>
    </section>
</div>
<PriceContextPanel @ref="contextPanel" View="view" SelectedId="@selectedProfileId" SelectedChanged="SelectProfile" LocateRequested="FocusProfile" DrawRange="ToggleRangeDrawing" LevelPicked="FromPriceReference" Timeframe="@timeframe" />
<OrderFlowPanel Flow="view.Flow" Provider="view.ProviderFlow" Candles="CurrentCandles" />
<MarketReadingPanel View="view" Watches="watches" />
<div class="lower-grid single-column">
    <section class="panel"><div class="panel-heading"><h2>观察记录</h2><span class="subtle-label">证据随事件保存</span></div><div class="event-list">
        @foreach (var a in alerts.Take(4)) { <button class="event-row" @onclick="() => selectedAlert = a"><span class="event-icon">↳</span><span><b>@a.Zone.Name</b><small>@LensFormat.Time(a.CreatedAt) · 观测价 <span class="mono">@LensFormat.Price(a.Price)</span></small></span><span class="push-right muted">查看 →</span></button> }
        @if (alerts.Length == 0) { <div class="empty-state compact"><span>⌁</span><b>等待新的到区事件</b><p>持续运行程序以监控最新行情。</p></div> }
    </div><div class="report-action"><div><b>整理当前观察</b><small>规则报告 · 含缺失证据</small></div><button class="button small" @onclick="OpenReport">生成报告 ↗</button></div></section>
</div>
@if (editor is not null)
{
    <div class="modal-backdrop"><section class="modal" role="dialog" aria-modal="true" aria-label="关注区编辑"><div class="modal-heading"><div><span class="eyebrow">WATCH ZONE</span><h2>@(editingId is null ? "建立关注区" : "编辑关注区")</h2></div><button class="icon-button" aria-label="关闭编辑" @onclick="CloseEditor">×</button></div>
        <form @onsubmit="SaveWatch" @onsubmit:preventDefault><label>名称<input required maxlength="100" @bind="editor.Name" /></label><div class="form-grid">@if (editor.Trend is { } line) { <label>关注距离（上下各 USDT）<input type="number" step="0.1" min="0.1" required @bind="editor.Distance" /></label><div class="form-note">@LensFormat.Time(line.Start) / @LensFormat.Price(line.Price1)<br />→ @LensFormat.Time(line.End) / @LensFormat.Price(line.Price2)</div> } else { <label>下边界<input type="number" step="0.1" min="0.1" required @bind="editor.Lower" /></label><label>上边界<input type="number" step="0.1" min="0.1" required @bind="editor.Upper" /></label> }<label>来源周期<select @bind="editor.Timeframe">@foreach (var tf in Timeframes.All) { <option>@tf</option> }</select></label><label>观察倾向<select @bind="editor.Bias"><option value="Neutral">待观察</option><option value="Bullish">看涨</option><option value="Bearish">看跌</option></select></label></div><label>关注原因<textarea rows="3" maxlength="2000" @bind="editor.Notes"></textarea></label>
        <p class="form-note">@(editor.Trend is null ? "保存后启用新版本的首次到区监控。" : "关注带随时间沿趋势线延伸。首次从带外靠近，或连续两次观测穿越趋势线时记录；同一版本记录一次。") 旧版本与过去的提醒继续保留。</p>
        @if (editingHistory.Length > 0) { <details><summary>已有版本记录（@editingHistory.Length）</summary>@foreach (var v in editingHistory) { <p class="muted">v@(v.Revision) · @v.Name · @LensFormat.Price(v.Lower)–@LensFormat.Price(v.Upper)</p> }</details> }
        @if (formError is not null) { <div class="inline-error">@formError</div> }
        <div class="modal-actions"><button type="button" class="button ghost" @onclick="CloseEditor">取消</button><button type="submit" class="button primary">保存并启用</button></div></form></section></div>
}
@if (selectedAlert is not null)
{
    <div class="modal-backdrop"><section class="modal wide" role="dialog" aria-modal="true" aria-label="提醒详情"><div class="modal-heading"><div><span class="eyebrow">EVENT SNAPSHOT · v@(selectedAlert.Revision)</span><h2>@selectedAlert.Zone.Name</h2></div><button class="icon-button" aria-label="关闭提醒" @onclick="() => selectedAlert = null">×</button></div><div class="snapshot-summary"><span>触发价格 <b class="mono">@LensFormat.Price(selectedAlert.Price)</b></span><span>@LensFormat.Time(selectedAlert.CreatedAt) · @selectedAlert.Transport</span></div><p>@selectedAlert.Summary</p><p class="muted">@selectedAlert.Zone.Notes</p><details><summary>查看保存的证据数据</summary><pre class="json-block">@Pretty(selectedAlert.EvidenceJson)</pre></details><div class="modal-actions"><button class="button" @onclick="ExportAlert">导出快照</button><a class="button primary" href="@("/journal?alert=" + Uri.EscapeDataString(selectedAlert.Id))">关联交易记录 →</a></div></section></div>
}
@if (report is not null)
{
    <div class="modal-backdrop"><section class="modal wide" role="dialog" aria-modal="true" aria-label="观察报告"><div class="modal-heading"><div><span class="eyebrow">OBSERVATION REPORT</span><h2>当前观察报告</h2></div><button class="icon-button" aria-label="关闭报告" @onclick="() => report = null">×</button></div><p class="muted">基于当前截止点的规则报告 · 可导出给智能体分析</p><h3>已观察到</h3><ul class="report-list">@foreach (var line in report.Observations) { <li>@line</li> }</ul><h3>尚缺证据</h3><ul class="report-list">@foreach (var line in report.Missing) { <li>@line</li> }</ul><h3>接下来观察</h3><ul class="report-list">@foreach (var line in report.NextSteps) { <li>@line</li> }</ul><div class="modal-actions"><button class="button primary" @onclick="ExportReport">导出分析 JSON</button></div></section></div>
}
@code {
    private MarketView view = MarketView.Empty;
    private WatchZone[] watches = [];
    private AlertEvent[] alerts = [];
    private string timeframe = "5m";
    private bool showFvg = true, showOb = true, showLevels = false, showHtf;
    private bool showDayVwap = true, showWeekVwap = true, showMonthVwap = true, showProfile = true;
    private string? selectedProfileId;
    private PriceContextPanel? contextPanel;
    private SavedProfile? SelectedProfile => view.PriceContext.Profiles.FirstOrDefault(p => p.Id == selectedProfileId);
    private VwapResult[] ChartVwaps => view.PriceContext.Vwaps.Where(v => v.Period switch { "day" => showDayVwap, "week" => showWeekVwap, _ => showMonthVwap }).ToArray();
    private WatchEditor? editor;
    private string? editingId, editorScope, formError;
    private int? editingRevision;
    private WatchVersion[] editingHistory = [];
    private AlertEvent? selectedAlert;
    private AnalysisPacket? report;
    private long lastRender;
    private string tool = "select";
    private bool objectsOpen;
    private ChartObjectSelection? selection;
    private ChartDrawing[] drawings = [];
    private CandleChart? candleChart;
    private Candle[] CurrentCandles => PriceContextRules.DisplayBars((timeframe == "5m" ? view.ContextCandles : [])
        .Concat(ChartProfiles.OrderBy(p => p.CreatedAt).SelectMany(p => p.SourceBars)), timeframe, view.Cutoff)
        .Concat(view.Candles.GetValueOrDefault(timeframe) ?? []).GroupBy(c => c.OpenTime).Select(g => g.Last()).OrderBy(c => c.OpenTime).ToArray();
    private SavedProfile[] ChartProfiles => showProfile ? view.PriceContext.Profiles.Where(p => p.Visible).ToArray() : [];
    private DetectedZone? SelectedZone => selection?.Kind == "zone" ? ChartZones.FirstOrDefault(z => z.Id == selection.Id) : null;
    private ChartDrawing? SelectedDrawing => selection?.Kind == "drawing" ? drawings.FirstOrDefault(d => d.Id == selection.Id) : null;
    private WatchZone? SelectedWatch => selection?.Kind == "watch" ? watches.FirstOrDefault(w => w.Id == selection.Id) : null;
    private string SelectionName => SelectedZone is { } z ? z.Timeframe + " " + LensFormat.Kind(z.Kind) : SelectedDrawing?.Name ?? SelectedWatch?.Current.Name ?? SelectedProfile?.Name ?? "";
    private string SelectionRange => SelectedZone is { } z ? LensFormat.Price(z.Lower) + " — " + LensFormat.Price(z.Upper)
        : SelectedDrawing is { } d ? LensFormat.Price(d.Lower) + " — " + LensFormat.Price(d.Upper)
        : SelectedWatch is { } w ? WatchRange(w.Current)
        : SelectedProfile is { } p ? LensFormat.Time(p.Result.Start) + " — " + LensFormat.Time(p.Result.End) : "";
    private IEnumerable<DetectedZone> VisibleZones => view.Zones.Where(z => z.Life == ZoneLife.Active)
        .Where(z => z.Timeframe == timeframe || showHtf && z.Timeframe is "1D" or "4H")
        .Where(z => z.Kind == ZoneKind.Fvg ? showFvg : showOb).OrderByDescending(z => z.KnownAt);
    private DetectedZone[] ChartZones => VisibleZones.ToArray();
    protected override void OnInitialized() { Reload(); Market.Changed += Changed; }
    private void Reload()
    {
        var oldScope = view.Scope; view = Market.View; watches = Store.Watches(view.Scope); alerts = Store.Alerts(view.Scope); drawings = Store.Drawings(view.Scope);
        if (oldScope != view.Scope) { CloseEditor(); selectedAlert = null; report = null; tool = "select"; selection = null; selectedProfileId = Store.GetSetting("selected-profile:" + view.Scope); }
        if (!view.PriceContext.Profiles.Any(p => p.Id == selectedProfileId)) selectedProfileId = view.PriceContext.Profiles.FirstOrDefault()?.Id;
        if (selection is not null && (selection.Kind == "zone" && SelectedZone is null || selection.Kind == "drawing" && SelectedDrawing is null || selection.Kind == "watch" && SelectedWatch is null || selection.Kind == "profile" && !ChartProfiles.Any(p => p.Id == selection.Id))) selection = null;
    }
    private void Changed()
    {
        var now = Environment.TickCount64;
        if (view.Mode == "live" && now - lastRender < 400 && view.Scope == Market.View.Scope) return;
        lastRender = now; _ = InvokeAsync(() => { Reload(); StateHasChanged(); });
    }
    private void NewWatch() { editingId = null; editingRevision = null; editingHistory = []; editorScope = view.Scope; formError = null; var price = view.Quote?.Price ?? 67000; editor = new() { Lower = price - 150, Upper = price - 50, Timeframe = timeframe }; }
    private void FromZone(DetectedZone zone) { NewWatch(); editor = new() { Name = zone.Timeframe + " " + LensFormat.Kind(zone.Kind) + " 观察", Lower = zone.Lower, Upper = zone.Upper, Timeframe = zone.Timeframe, Bias = zone.Bias, Notes = "等待到区后观察局部反应。", SourceId = zone.Id, Anchor = new(null, zone.SourceTime, zone.KnownAt) }; }
    private void EditWatch(WatchZone w) { editingId = w.Id; editingRevision = w.Current.Revision; editingHistory = [.. w.History, w.Current]; editorScope = view.Scope; formError = null; var v = w.Current; editor = new() { Name = v.Name, Lower = v.Lower, Upper = v.Upper, Timeframe = v.Timeframe, Bias = v.Bias, Notes = v.Notes, SourceId = v.SourceZoneId, Reference = v.PriceReference, Anchor = v.ChartAnchor, Trend = v.Trend, Distance = v.Trend?.Tolerance ?? 25 }; }
    private void SetTool(string value) { tool = value; objectsOpen = false; }
    private void ToggleRangeDrawing() => SetTool(tool == "profile" ? "select" : "profile");
    private void RangePicked((long Start, long End) range) { tool = "select"; contextPanel?.OpenRange(range.Start, range.End); }
    private void SelectProfile(string id) { selectedProfileId = id; Store.SetSetting("selected-profile:" + view.Scope, id); selection = new("profile", id); Reload(); }
    private void SelectObject(ChartObjectSelection value) { selection = value.Kind.Length == 0 ? null : value; if (value.Kind == "profile") selectedProfileId = value.Id; }
    private async Task SelectAndFocus(ChartObjectSelection value) { SelectObject(value); objectsOpen = false; if (candleChart is not null) await candleChart.FocusAsync(value.Kind, value.Id); }
    private Task FocusSelection() => selection is null || candleChart is null ? Task.CompletedTask : candleChart.FocusAsync(selection.Kind, selection.Id);
    private async Task FocusProfile(string id) { showProfile = true; await Market.SetProfileVisibilityAsync(id, true, view.Scope); Reload(); selectedProfileId = id; selection = new("profile", id); StateHasChanged(); await Task.Yield(); if (candleChart is not null) await candleChart.FocusAsync("profile", id); }
    private void PromoteSelection()
    {
        if (SelectedZone is { } z) { FromZone(z); return; }
        if (SelectedDrawing is not { } d) return;
        NewWatch(); var pad = d.Kind is DrawingKind.HorizontalLine or DrawingKind.TrendLine ? 25m : 0m;
        editor = new() { Name = d.Name + " 观察", Lower = Math.Max(.1m, d.Lower - pad), Upper = d.Upper + pad, Timeframe = timeframe,
            Notes = d.Kind == DrawingKind.TrendLine ? "沿趋势线向未来延伸，观察价格靠近或穿越时的反应。" : "观察所画区域内的价格反应。",
            Anchor = new(d.Id, d.Start, d.End, d.Revision), Trend = d.Kind == DrawingKind.TrendLine ? new(d.Start, d.End, d.Price1, d.Price2, pad) : null, Distance = pad };
    }
    private void ProfilePoc(SavedProfile p) => FromPriceReference((new("profile", p.Id, p.Name + " · POC", p.Result.Poc!.Value, p.CreatedAt, p.Result.Algorithm, p.Result.SourceHash), p.DisplayTimeframe));
    private async Task SaveChartObject(DrawingChange change)
    {
        tool = "select";
        try
        {
            if (change.Kind == "Watch")
            {
                var watch = watches.FirstOrDefault(w => w.Id == change.Id) ?? throw new ArgumentException("关注区已删除。");
                var trend = watch.Current.Trend is { } t ? t with { Start = change.Start, End = change.End, Price1 = change.Price1, Price2 = change.Price2 } : null;
                await Market.SaveWatchAsync(watch.Id, change.Revision, watch.Current with { Lower = Math.Max(.1m, Math.Min(change.Price1, change.Price2) - (trend?.Tolerance ?? 0)), Upper = Math.Max(change.Price1, change.Price2) + (trend?.Tolerance ?? 0), Trend = trend, ChartAnchor = new(watch.Current.ChartAnchor?.DrawingId, change.Start, change.End, watch.Current.ChartAnchor?.DrawingRevision) }, change.Scope);
                selection = new("watch", watch.Id);
            }
            else { var saved = await Market.SaveDrawingAsync(change); selection = new("drawing", saved.Id); }
            Reload();
        }
        catch (ArgumentException ex) { Reload(); Snack.Add(ex.Message, Severity.Warning); }
    }
    private async Task DeleteObject(ChartObjectSelection value)
    {
        try
        {
            if (value.Kind == "watch" && watches.FirstOrDefault(w => w.Id == value.Id) is { } w) { await DeleteWatch(w); }
            else if (value.Kind == "drawing" && drawings.FirstOrDefault(d => d.Id == value.Id) is { } d) await Market.DeleteDrawingAsync(d.Id, d.Revision, view.Scope);
            else if (value.Kind == "profile") await Market.DeleteProfileAsync(value.Id, view.Scope);
            else return;
            selection = null; Reload(); Snack.Add("已删除所选对象。", Severity.Success);
        }
        catch (ArgumentException ex) { Reload(); Snack.Add(ex.Message, Severity.Warning); }
    }
    private void FromPriceReference((PriceReference Reference, string Timeframe) source)
    {
        NewWatch(); var r = source.Reference; var padding = Math.Max(view.Instrument?.TickSize ?? .1m, 25m);
        editor = new() { Name = r.Label + " 观察", Lower = Math.Max(.1m, Math.Floor((r.Price - padding) * 10) / 10), Upper = Math.Ceiling((r.Price + padding) * 10) / 10,
            Timeframe = source.Timeframe, Notes = "参考 " + r.Label + "，保存时价位 " + r.Price.ToString("0.0") + "；按自己的判断调整关注区宽度。", Reference = r };
    }
    private void CloseEditor() { editor = null; formError = null; }
    private async Task DeleteWatch(WatchZone watch)
    {
        try
        {
            await Market.DeleteWatchAsync(watch.Id, watch.Current.Revision, watch.Scope);
            if (editingId == watch.Id) CloseEditor();
            Reload(); report = null;
            Snack.Add("关注区已删除，监控已停止。", Severity.Success);
        }
        catch (ArgumentException ex) { Reload(); Snack.Add(ex.Message, Severity.Warning); }
    }
    private async Task SaveWatch()
    {
        try
        {
            if (editorScope != Market.View.Scope) throw new ArgumentException("工作区已变化，请重新建立关注区。");
            var e = editor!;
            if(e.Trend is { } trend) {e.Lower=Math.Max(.1m,Math.Min(trend.Price1,trend.Price2)-e.Distance);e.Upper=Math.Max(trend.Price1,trend.Price2)+e.Distance;}
            var saved = await Market.SaveWatchAsync(editingId, editingRevision, new WatchVersion(0, e.Name, e.Lower, e.Upper, e.Timeframe, e.Bias, e.Notes, e.SourceId, default) { PriceReference = e.Reference, ChartAnchor = e.Anchor, Trend = e.Trend is { } t ? t with { Tolerance = e.Distance } : null }, editorScope);
            CloseEditor(); Reload(); selection = new("watch", saved.Id); Snack.Add("关注区已保存，首次到区监控已启用。", Severity.Success);
        }
        catch (ArgumentException ex) { formError = ex.Message; }
    }
    private void OpenReport() => report = AnalysisReport.Build(view, watches);
    private static string Pretty(string value) { using var doc = System.Text.Json.JsonDocument.Parse(value); return System.Text.Json.JsonSerializer.Serialize(doc, new System.Text.Json.JsonSerializerOptions { WriteIndented = true }); }
    private async Task Download(string name, string json) { await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/files.js"); await module.InvokeVoidAsync("download", name, Pretty(json)); }
    private Task ExportAlert() => Download("btclens-event.json", JsonCodec.Write(selectedAlert));
    private Task ExportReport() => Download("btclens-analysis.json", JsonCodec.Write(report));
    public void Dispose() => Market.Changed -= Changed;
    private string WatchRange(WatchVersion version) => WatchRules.Bounds(version, view.Quote?.Timestamp ?? view.Cutoff) is { } b ? $"{LensFormat.Price(b.Lower)} — {LensFormat.Price(b.Upper)}" : "趋势线已延伸至无效价格";
    private sealed class WatchEditor { public string Name { get; set; } = "我的关注区"; public decimal Lower { get; set; } public decimal Upper { get; set; } public string Timeframe { get; set; } = "5m"; public Bias Bias { get; set; } public string Notes { get; set; } = ""; public string? SourceId { get; set; } public PriceReference? Reference { get; set; } public ChartAnchor? Anchor { get; set; } public TrendWatch? Trend { get; set; } public decimal Distance { get; set; } = 25; }
}
