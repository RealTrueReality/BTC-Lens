@inherits LayoutComponentBase
@implements IDisposable
@inject MarketEngine Market
@inject NavigationManager Navigation
<MudThemeProvider IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<div class="app-shell">
    <aside class="sidebar">
        <a href="/" class="brand"><span class="brand-mark"><svg viewBox="0 0 32 32"><path d="M6 24V15m6 6V8m6 17V12m6 6V5" /><path d="M3 19l8-6 8 4 10-10" /></svg></span><span>BTC <b>Lens</b><small>看盘 · 记录 · 复盘</small></span></a>
        <div class="nav-label">工作空间</div>
        <nav>
            <NavLink href="/" Match="NavLinkMatch.All"><span class="nav-icon">◉</span>行情雷达<span class="nav-end">01</span></NavLink>
            <NavLink href="/journal"><span class="nav-icon">▤</span>交易手记<span class="nav-end">02</span></NavLink>
            <NavLink href="/statistics"><span class="nav-icon">▥</span>复盘统计<span class="nav-end">03</span></NavLink>
            <NavLink href="/guide"><span class="nav-icon">◇</span>规则与数据<span class="nav-end">04</span></NavLink>
        </nav>
        <div class="sidebar-bottom"><span class="status-dot"></span>本地个人工作区<span class="version">v0.2.4</span></div>
    </aside>
    <div class="workspace">
        <header class="topbar">
            <div class="breadcrumb">工作空间 <span>/</span> <b>@PageName</b></div>
            <div class="topbar-right"><span class="top-status"><span class="status-dot"></span>@Market.View.Transport</span><span class="pill green">实时 OKX</span></div>
        </header>
        <main>@Body</main>
        <footer class="app-footer"><span>BTC Lens <span class="muted">·</span> 从观察到复盘</span><a href="https://www.tradingview.com/" target="_blank" rel="noopener noreferrer">Charts by TradingView</a></footer>
    </div>
</div>
<div id="blazor-error-ui" data-nosnippet>连接出现异常，请重新加载。<a href="." class="reload">重新加载</a><span class="dismiss">×</span></div>
@code {
    private string PageName => Navigation.Uri.Contains("journal") ? "交易手记" : Navigation.Uri.Contains("statistics") ? "复盘统计" : Navigation.Uri.Contains("guide") ? "规则与数据" : "行情雷达";
    protected override void OnInitialized() { Market.Changed += Update; Navigation.LocationChanged += LocationChanged; }
    private void Update() => _ = InvokeAsync(StateHasChanged);
    private void LocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => Update();
    public void Dispose() { Market.Changed -= Update; Navigation.LocationChanged -= LocationChanged; }
}
